# Same container as ./Dockerfile, without downloading: node_modules copied from
# an image already on the machine that holds vite 8.3.3 and
# @cloudflare/vite-plugin 1.62.5 (miniflare 5.20261001.0-alpha, workerd
# 1.20261001.1). Tag that image as repro-toolchain-source:local first.
FROM repro-toolchain-source:local AS toolchain
FROM docker.io/cloudflare/sandbox:0.12.7@sha256:6d741713aef266e8ae0831a5709c6f2d7b77b4952ac79b549f4f4e380af86fbe
# The source path inside that local image is redacted here.
COPY --from=toolchain /opt/<toolchain>/node_modules /opt/repro/node_modules
